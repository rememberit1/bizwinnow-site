<style>
:root{--n:#0b2545;--g:#c9a227;--l:#f4f6fa}*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#1a1a1a;line-height:1.6}
a{color:var(--n)}.w{max-width:1040px;margin:auto;padding:0 20px}
nav{background:var(--n);color:#fff}nav .w{display:flex;justify-content:space-between;align-items:center;padding:14px 20px}nav b{font-size:1.15rem}nav a{color:#fff;text-decoration:none;margin-left:18px;font-size:.95rem}
.hero{background:linear-gradient(135deg,var(--n),#13315c);color:#fff;padding:80px 0}.hero h1{font-size:clamp(2rem,5vw,3.2rem);margin:0 0 12px;line-height:1.15}.hero p{font-size:1.15rem;max-width:640px;opacity:.92}
.btn{display:inline-block;background:var(--g);color:var(--n);font-weight:700;padding:12px 22px;border-radius:6px;text-decoration:none;margin:8px 10px 0 0}.btn.o{background:transparent;color:#fff;border:2px solid #fff}
section{padding:60px 0}section:nth-of-type(even){background:var(--l)}h2{color:var(--n);font-size:1.8rem;margin-top:0}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}.card{background:#fff;border:1px solid #dde3ee;border-radius:10px;padding:20px}.card h3{margin:0 0 6px;color:var(--n)}
.step b{display:inline-flex;width:34px;height:34px;border-radius:50%;background:var(--g);color:var(--n);align-items:center;justify-content:center;margin-bottom:8px}
.price{font-size:1.6rem;font-weight:800;color:var(--n)}footer{background:var(--n);color:#cfd8e6;padding:24px 0;font-size:.9rem}
.svc{display:flex;flex-direction:column}.svc .for{font-size:.9rem;color:#555;margin:0 0 10px}.svc ul{margin:6px 0 12px;padding-left:20px}.svc .from{font-weight:800;color:var(--n);margin-top:auto;padding-bottom:6px}.svc .btn{margin:6px 0 0;text-align:center}.svc .lnk{font-size:.9rem;margin:8px 0 0}
